{
  "manifest_version": 3,
  "name": "LeadQualify — AI Prospect Scorer",
  "version": "2.1.0",
  "description": "Score LinkedIn prospects against your ICP using AI. Deterministic weighted scoring over a 3-model Groq cascade.",

  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "sidePanel"
  ],

  "host_permissions": [
    "https://www.linkedin.com/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "side_panel": {
    "default_path": "popup.html"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/in/*",
        "https://www.linkedin.com/company/*",
        "https://www.linkedin.com/sales/lead/*",
        "https://www.linkedin.com/sales/company/*",
        "https://www.linkedin.com/sales/people/*",
        "https://www.linkedin.com/sales/search/*",
        "https://www.linkedin.com/sales/lists/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
